# O Netlify não declarava charset=utf-8 pro manifest.json — o Safari cai
# num fallback de codificação errado ao ler os campos com acento (ex.
# "cadência" virava "cadÃªncia"), e pode ser esse exato motivo de o iOS
# não reconhecer a página como um PWA instalável de verdade na hora de
# "Adicionar à Tela de Início" (fica como "bookmark" em vez de "app", e o
# ícone cai no fallback de gerar uma letra sozinho). application/manifest+
# json é o tipo MIME recomendado pela spec do Web App Manifest — mais
# estrito/correto que o application/json genérico que o Netlify usava.
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8

# Mesmo motivo — texto com acento (ex. nomes de gênero) também pode vir
# corrompido sem isso.
/data/runbeat-catalog.json
  Content-Type: application/json; charset=utf-8
